/* ================= DEFINES ================= */
#define MPU6050_ADDR        (0x68 << 1)
#define MPU6050_WHO_AM_I    0x75
#define MPU6050_PWR_MGMT_1  0x6B
#define MPU6050_ACCEL_XOUT  0x3B
#define MPU6050_GYRO_XOUT   0x43

/* ================= HANDLES ================= */
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart1;

/* ================= PROTOTYPES ================= */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_USART1_UART_Init(void);

void printu(uint8_t *msg);
void MPU6050_Detect(void);
void MPU6050_Init(void);
void MPU6050_Read_All(void);

/* ================= MAIN ================= */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();

  HAL_Delay(100);

  //printu((uint8_t *)"\r\n--- MPU6050 TEST ---\r\n");

  //MPU6050_Detect();
  MPU6050_Init();

  while (1)
  {
    MPU6050_Read_All();
    HAL_Delay(500);
  }
}

/* ================= UART PRINT ================= */
void printu(uint8_t *msg)
{
  HAL_UART_Transmit(&huart1, msg, strlen((char *)msg), HAL_MAX_DELAY);
}

/* ================= MPU6050 DETECT ================= */
void MPU6050_Detect(void)
{
  uint8_t who = 0;
  char msg[50];

  if (HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR,
                       MPU6050_WHO_AM_I, 1,
                       &who, 1, HAL_MAX_DELAY) == HAL_OK)
  {
    sprintf(msg, "WHO_AM_I = 0x%02X\r\n", who);
    printu((uint8_t *)msg);

    if (who == 0x68)
      printu((uint8_t *)"MPU6050 DETECTED ✅\r\n");
    else
      printu((uint8_t *)"WRONG DEVICE ❌\r\n");
  }
  else
  {
    printu((uint8_t *)"MPU6050 NOT FOUND ❌\r\n");
  }
}

/* ================= MPU6050 INIT ================= */
void MPU6050_Init(void)
{
  uint8_t data = 0x00;  // wake up device
  HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR,
                    MPU6050_PWR_MGMT_1, 1,
                    &data, 1, HAL_MAX_DELAY);

  //printu((uint8_t *)"MPU6050 INITIALIZED\r\n\r\n");
}

/* ================= READ ACCEL + GYRO ================= */
void MPU6050_Read_All(void)
{
  uint8_t rawData[14];
  int16_t ax, ay, az, gx, gy, gz;
  char msg[150];

  HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR,
                   MPU6050_ACCEL_XOUT, 1,
                   rawData, 14, HAL_MAX_DELAY);

  ax = (rawData[0] << 8) | rawData[1];
  ay = (rawData[2] << 8) | rawData[3];
  az = (rawData[4] << 8) | rawData[5];

  gx = (rawData[8] << 8) | rawData[9];
  gy = (rawData[10] << 8) | rawData[11];
  gz = (rawData[12] << 8) | rawData[13];

  sprintf(msg,
          "ACCEL  X:%6d  Y:%6d  Z:%6d | "
          "GYRO  X:%6d  Y:%6d  Z:%6d\r\n",
          ax, ay, az, gx, gy, gz);

  printu((uint8_t *)msg);
}

