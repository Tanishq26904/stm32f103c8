#include "MPU6050.h"
/* USER CODE END Includes */

/* USER CODE BEGIN PD */
#define MPU6050_ADDR        (0x68 << 1)   // HAL uses 8-bit address
#define MPU6050_WHO_AM_I    0x75
/* USER CODE END PD */

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart1;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_USART1_UART_Init(void);

/* USER CODE BEGIN PFP */
void printu(uint8_t *msg);
void MPU6050_Detect(void);
/* USER CODE END PFP */

int main(void)
{
  /* Reset peripherals */
  HAL_Init();

  /* Configure system clock */
  SystemClock_Config();

  /* Initialize peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();

  /* Small delay for stability */
  HAL_Delay(100);

  /* Detect MPU6050 */
  printu((uint8_t *)"\r\n--- MPU6050 Detection Start ---\r\n");
  MPU6050_Detect();

  /* Optional: Initialize MPU6050 after detection */
  MPU6050_init();

  /* Infinite loop */
  while (1)
  {
    HAL_Delay(1000);
  }
}

/* ================= UART PRINT ================= */
void printu(uint8_t *msg)
{
    HAL_UART_Transmit(&huart1,
                      msg,
                      strlen((char*)msg),
                      HAL_MAX_DELAY);
}

/* ================= MPU6050 DETECTION ================= */
void MPU6050_Detect(void)
{
    uint8_t who_am_i = 0;
    char msg[64];

    if (HAL_I2C_Mem_Read(&hi2c1,
                         MPU6050_ADDR,
                         MPU6050_WHO_AM_I,
                         I2C_MEMADD_SIZE_8BIT,
                         &who_am_i,
                         1,
                         HAL_MAX_DELAY) == HAL_OK)
    {
        sprintf(msg, "WHO_AM_I = 0x%02X\r\n", who_am_i);
        printu((uint8_t *)msg);

        if (who_am_i == 0x68)
        {
            printu((uint8_t *)"MPU6050 DETECTED ✅\r\n");
        }
        else
        {
            printu((uint8_t *)"MPU6050 WRONG DEVICE ❌\r\n");
        }
    }
    else
    {
        printu((uint8_t *)"MPU6050 NOT FOUND ❌ (I2C ERROR)\r\n");
    }
}

