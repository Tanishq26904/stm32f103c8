#include "main.h"
#include "bmp180.h"
#include <stdio.h>
#include <string.h>

/* Peripheral handles */
UART_HandleTypeDef huart1;
I2C_HandleTypeDef hi2c1;

/* Function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART1_UART_Init(void);
static void MX_I2C1_Init(void);

/* Retarget printf to UART (optional but useful) */
int _write(int file, char *ptr, int len)
{
    HAL_UART_Transmit(&huart1, (uint8_t*)ptr, len, HAL_MAX_DELAY);
    return len;
}

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_USART1_UART_Init();

    printf("Starting BMP180...\r\n");
    if (HAL_I2C_IsDeviceReady(&hi2c1, (0x77 << 1), 3, 100) == HAL_OK)
       {
           printf("BMP180 detected on I2C\r\n");
       }
       else
       {
           printf("BMP180 NOT detected\r\n");
       }


    /* Initialize BMP180 */
    BMP180_Start();
    HAL_Delay(100);

    while (1)
    {
        /* ---- ONLY ONE VALUE FOR TEST ---- */
        float temperature = BMP180_GetAltitude();

        printf("Temperature: %.2f C\r\n", temperature);

        HAL_Delay(1000);
    }
}

