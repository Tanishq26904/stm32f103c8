/**
  * @brief Read all MPU6050 data (accelerometer, gyroscope, temperature)
  * @param data Pointer to MPU6050_Data_t structure
  * @retval None
  */
void MPU6050_Read_All(MPU6050_Data_t *data)
{
    // Read accelerometer
    MPU6050_Read_Accel(&data->accel[0], &data->accel[1], &data->accel[2]);

    // Read gyroscope
    MPU6050_Read_Gyro(&data->gyro[0], &data->gyro[1], &data->gyro[2]);

    // Read temperature (if you add this function to MPU6050.h)
    // data->temperature = MPU6050_Read_Temp();
}

